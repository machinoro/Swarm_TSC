<?xml version="1.0" encoding="UTF-8"?>
<robot name="OS1-64" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="M_PI" value="3.1415926535897931"></xacro:property>
  <xacro:macro name="os1" params="*origin parent:=base_link name:=os1_sensor hz:=10 noise:=0.008 min_angle:=-${M_PI} max_angle:=${M_PI} lidar_link:=os1_lidar imu_link:=os1_imu vfov_min:=-.26 vfov_max:=.26">
    <joint name="${name}_mount_joint" type="fixed">
      <xacro:insert_block name="origin"></xacro:insert_block>
      <parent link="${parent}"></parent>
      <child link="${name}"></child>
    </joint>
    <link name="${name}">
      <inertial>
        <mass value="0.33"></mass>
        <origin rpy="0 0 0" xyz="0 0 0.0365"></origin>
        <inertia ixx="0.000241148" ixy="0" ixz="0" iyy="0.000241148" iyz="0" izz="0.000264"></inertia>
      </inertial>
      <collision name="${name}_collision">
        <origin rpy="0 0 0" xyz="0 0 0.0365"></origin>
        <geometry>
          <cylinder length="0.073" radius="0.04"></cylinder>
        </geometry>
      </collision>
      <visual name="${name}_visual">
        <origin rpy="0 0 1.5707" xyz="0 0 0.0"></origin>
        <geometry>
          <mesh filename="package://tarot_description/models/tarot/meshes/collision/os1.stl"></mesh>
        </geometry>
      </visual>
    </link>
    <link name="${imu_link}"></link>
    <link name="${lidar_link}"></link>
    <joint name="${name}_imu_joint" type="fixed">
      <parent link="${name}"></parent>
      <child link="${imu_link}"></child>
      <origin rpy="0 0 0" xyz="0.006253 -0.011775 0.007645"></origin>
    </joint>
    <joint name="${name}_lidar_joint" type="fixed">
      <parent link="${name}"></parent>
      <child link="${lidar_link}"></child>
      <origin rpy="0 0 0" xyz="0.0 0.0 0.03618"></origin>
    </joint>
    <gazebo reference="${lidar_link}">
      <sensor name="${name}_lidar" type="gpu_lidar">
        <pose relative_to="${name}">0 0 0 0 0 0</pose>
        <gz_frame_id>${lidar_link}</gz_frame_id>
        <visualize>false</visualize>
        <update_rate>${hz}</update_rate>
        <topic>/os1</topic>
        <frame_id>${lidar_link}</frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>1024</samples>
              <resolution>1</resolution>
              <min_angle>${min_angle}</min_angle>
              <max_angle>${max_angle}</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>${vfov_min}</min_angle>
              <max_angle>${vfov_max}</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.8</min>
            <max>100.0</max>
            <resolution>0.03</resolution>
          </range>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>${noise}</stddev>
          </noise>
        </lidar>
      </sensor>
    </gazebo>
    <gazebo reference="${imu_link}">
      <sensor name="${name}_imu" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>100.0</update_rate>
        <topic>/os1_cloud_node/imu</topic>
        <frame_id>${imu_link}</frame_id>
        <imu>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.005</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.005</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.005</stddev>
              </noise>
            </z>
          </linear_acceleration>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.005</stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.005</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0</mean>
                <stddev>0.005</stddev>
              </noise>
            </z>
          </angular_velocity>
        </imu>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
